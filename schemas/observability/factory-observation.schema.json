{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASF-Core Factory Observation",
  "type": "object",
  "required": ["repository", "commit_sha", "gate_name", "visibility_state", "confidence", "timestamp", "reason"],
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "gate_name": {"type": "string", "minLength": 1},
    "workflow_identity": {"type": ["string", "null"]},
    "event_type": {"type": ["string", "null"]},
    "run_id": {"type": ["integer", "null"]},
    "check_id": {"type": ["integer", "null"]},
    "job_results": {"type": "array"},
    "artifact_results": {"type": "array"},
    "visibility_state": {"enum": ["WORKFLOW_VISIBLE", "WORKFLOW_NOT_VISIBLE", "CHECK_VISIBLE", "CHECK_NOT_VISIBLE", "EVIDENCE_COMPLETE", "EVIDENCE_INCOMPLETE"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "timestamp": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
