{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ASF Gate Evidence Record","type":"object","required":["commit_sha","workflow_id","workflow_name","event_type","state","observed_at"],"properties":{"commit_sha":{"type":"string","pattern":"^[0-9a-fA-F]{40}$"},"workflow_id":{"type":["integer","string"]},"workflow_name":{"type":"string","minLength":1},"workflow_path":{"type":"string"},"event_type":{"type":"string","minLength":1},"run_id":{"type":["integer","null"]},"run_status":{"type":["string","null"]},"run_conclusion":{"type":["string","null"]},"job_result":{"type":["string","null"]},"artifact_result":{"type":["string","null"]},"check_result":{"type":["string","null"]},"observation_source":{"type":"string","minLength":1},"observed_at":{"type":"string","format":"date-time"},"state":{"type":"string","enum":["SUCCESS","FAILURE","PENDING","NOT_FOUND","NOT_EXPOSED"]},"evidence_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}